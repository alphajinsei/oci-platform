# Managed by Ansible (oci-platform/ansible/roles/mail). Edit the template, not this file.
# 効いている設定は `doveconf -n`

protocols = imap lmtp
listen = *

# ---- TLS：メールソフトとの間は必ず暗号化する ----
ssl = required
ssl_cert = </etc/letsencrypt/live/{{ mail_hostname }}/fullchain.pem
ssl_key = </etc/letsencrypt/live/{{ mail_hostname }}/privkey.pem
ssl_dh = </usr/share/dovecot/dh.pem
ssl_min_protocol = TLSv1.2

# ---- ログイン：ユーザー名はメールアドレスそのもの ----
# 暗号化されていない接続ではログインさせない
disable_plaintext_auth = yes
auth_mechanisms = plain login
# パスワードはファイル（Ansible が Vault から作る）。Linux のユーザー（PAM）では入れない
passdb {
  driver = passwd-file
  args = scheme=SHA512-CRYPT username_format=%u /etc/dovecot/users
}
# 全員が vmail（uid 5000）として、/srv/mail/<ドメイン>/<ユーザー>/ を使う
userdb {
  driver = static
  args = uid=vmail gid=vmail home=/srv/mail/%d/%n
}

# ---- メールボックス ----
mail_location = maildir:~/Maildir
namespace inbox {
  inbox = yes
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
}

# ---- 待ち受け ----
# IMAP は 993番（最初から TLS）だけ。143番（平文で始める）は開けない
service imap-login {
  inet_listener imap {
    port = 0
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

# Postfix から受け取る口（Postfix の chroot の中に置く）
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

# Postfix の 465・587番のログインの確認を受ける口（SASL）
service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}

protocol lmtp {
  postmaster_address = postmaster@{{ mail_domain }}
}
