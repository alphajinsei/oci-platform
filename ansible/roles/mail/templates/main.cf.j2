# Managed by Ansible (oci-platform/ansible/roles/mail). Edit the template, not this file.
# 設定の一覧と既定値は `postconf -d`、今効いている値は `postconf -n`

# ---- 自分の名前 ----
myhostname = {{ mail_hostname }}
mydomain = {{ mail_domain }}
myorigin = $mydomain
# Linux のユーザー宛て（root など）として受けるのは localhost だけ。alphajinsei.com は下の virtual で受ける
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4

# ---- 受け取る宛先（virtual：メールのユーザーを Linux のユーザーにしない） ----
virtual_mailbox_domains = {{ mail_domain }}
# 受け取ってよい宛先の一覧。ここにない宛先は 550 で拒否する（右側の値は使わない。保存先は Dovecot が決める）
virtual_mailbox_maps = hash:/etc/postfix/vmailbox
# 別名 -> 本当の宛先（postmaster@ など）。Dovecot に渡す前に Postfix が置き換える
virtual_alias_maps = hash:/etc/postfix/virtual
# 保存は Dovecot に任せる（LMTP。Dovecot が Maildir に書き、索引も更新する）
virtual_transport = lmtp:unix:private/dovecot-lmtp

# ---- 中継の制限（オープンリレーにしない） ----
# 信頼するのは自分自身だけ。それ以外から、よそのドメイン宛てを頼まれたら拒否する（Relay access denied）
mynetworks = 127.0.0.0/8
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination

# ---- 受け付けの作法 ----
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_banner = $myhostname ESMTP
message_size_limit = 26214400

# ---- TLS（受ける側。相手が対応していれば使う） ----
# 証明書は Let's Encrypt（certbot が更新し、deploy フックで読み直す）。Dovecot と同じもの
smtpd_tls_cert_file = /etc/letsencrypt/live/{{ mail_hostname }}/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/{{ mail_hostname }}/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes

# ---- 送信の受付（465・587番。master.cf で、この2つのポートだけログインを有効にする） ----
# ログインの確認は Dovecot に任せる（同じユーザーとパスワード）
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
# ログインしたユーザーが、封筒の差出人として名乗ってよいアドレス（他人を名乗らせない）
smtpd_sender_login_maps = hash:/etc/postfix/sender_login

# ---- 送る側：外への配送は全部 Email Delivery に中継する（外への 25番は OCI が塞いでいる） ----
relayhost = [{{ mail_relay.host }}]:{{ mail_relay.port }}
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
# 中継先には必ず TLS で、証明書も確かめてからパスワードを渡す
smtp_tls_security_level = secure
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt

compatibility_level = 3.6
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
