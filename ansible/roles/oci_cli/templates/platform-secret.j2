#!/usr/bin/env bash
# platform-secret <名前>：共通基盤の Vault からシークレットを取り出し、中身を標準出力に出す。
# VM 自身の権限（インスタンス・プリンシパル）で読むので、鍵もパスワードも要らない
set -euo pipefail
source /etc/oci-platform.env
/home/ubuntu/.local/bin/oci secrets secret-bundle get-secret-bundle-by-name --auth instance_principal \
  --vault-id "$VAULT_ID" --secret-name "$1" \
  --query 'data."secret-bundle-content".content' --raw-output | base64 -d
